# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which carries the variable NAMES only, so anyone
# cloning knows what to set. A deeper .gitignore overrides the root one, so
# this exception has to be repeated here.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
