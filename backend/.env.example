# Signing key for JWTs. The app falls back to a dev default if unset, which is
# fine locally and NOT fine anywhere real - anyone with the repo could forge a
# token for any user. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser.
# Unset is fine locally - it defaults to the two localhost:3000 spellings.
# On Render this is filled in automatically by render.yaml.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
