# ---------------------------------------------------------------------------
# Python / FastAPI backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# The SQLite database is generated data, never source.
# Recreate it any time with:  python -m app.seed
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Node / Next.js frontend
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
.eslintcache
# Regenerated by `next dev` on every run
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# NOTE: package-lock.json is deliberately NOT ignored. The lockfile is what
# makes `npm ci` reproducible, so it belongs in the repo.

# ---------------------------------------------------------------------------
# Secrets and local config
#
# Every .env is ignored EXCEPT the .example files, which carry the variable
# names (never the values) so anyone cloning knows what to set.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors, OS cruft, local tooling
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# AI assistant config — local tooling, not part of the project.
# Next regenerates AGENTS.md/CLAUDE.md on `next dev`; ignoring them keeps
# `git status` clean instead of showing a permanently modified file.
.claude/
AGENTS.md
CLAUDE.md

# ---------------------------------------------------------------------------
# Assignment brief — reference material, not source
# ---------------------------------------------------------------------------
air.pdf
*.pdf
